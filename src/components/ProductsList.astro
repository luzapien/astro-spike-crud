---
import Layout from '../layouts/Layout.astro';
import { apiProducts } from '../api/products';

const products = await apiProducts.getProducts();
---


<Layout title="Catálogo de Productos - Demo">
  <main style="max-width: 1200px; margin: 0 auto; padding: 2rem;">
    <h1>Catálogo de Productos (Demo CRUD)</h1>
    
    <a href="/create" style="display: inline-block; background: #0070f3; color: white; padding: 0.5rem 1rem; text-decoration: none; border-radius: 4px; margin-bottom: 2rem;">
      + Crear Nuevo Producto
    </a>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1.5rem;">
      {products.map((product: any) => (
        <div style="border: 1px solid #eaeaea; border-radius: 8px; padding: 1rem; background: #fff;">
          <img src={product.thumbnail} alt={product.title} style="width: 100%; height: 150px; object-fit: cover; border-radius: 4px;" />
          <h3>{product.title}</h3>
          <p style="color: #666; font-size: 0.9rem;">{product.description.slice(0, 60)}...</p>
          <p style="font-weight: bold; color: #0070f3;">${product.price}</p>
        </div>
      ))}
    </div>
  </main>
</Layout>
