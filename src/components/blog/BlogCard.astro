---
const { post } = Astro.props;
---

<article class="blog-card">
  <div class="blog-card-content">
    <p class="blog-card-category">BLOG</p>

    <h2 class="blog-card-title">
      {post.data.title}
    </h2>

    <p class="blog-card-description">
      {post.data.description}
    </p>

    <div class="blog-card-footer">
      <p class="blog-card-author">
        Por {post.data.author}
      </p>

      <a
        class="blog-card-link"
        href={`/blog/${post.id}`}
      >
        Leer artículo →
      </a>
    </div>
  </div>
</article>

<style>
  .blog-card {
    width: 100%;
    max-width: 700px;
    margin: 0 auto 1.5rem;
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    overflow: hidden;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .blog-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
  }

  .blog-card-content {
    padding: 1.5rem;
  }

  .blog-card-category {
    margin: 0 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #6b7280;
  }

  .blog-card-title {
    margin: 0 0 0.75rem;
    font-size: 1.5rem;
    line-height: 1.3;
    color: #111827;
  }

  .blog-card-description {
    margin: 0 0 1.25rem;
    color: #6b7280;
    line-height: 1.6;
  }

  .blog-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid #f0f0f0;
  }

  .blog-card-author {
    margin: 0;
    font-size: 0.875rem;
    color: #6b7280;
  }

  .blog-card-link {
    color: #2563eb;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .blog-card-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 600px) {
    .blog-card-footer {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
