---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const { slug } = Astro.params;

const posts = await getCollection("blog");

const post = posts.find((post) => post.id === slug);

if (!post) {
  return Astro.redirect("/404");
}

const { Content } = await render(post);
---

<Layout title={post.data.title}>
  <main>
    <article>
      <header class="post-header">
        <p class="post-label">BLOG</p>

        <h1>{post.data.title}</h1>

        <p class="description">
          {post.data.description}
        </p>

        <p class="author">
          Por {post.data.author}
        </p>
      </header>

      {post.data.image && (
        <div class="post-image-wrapper">
          <img
            class="post-image"
            src={post.data.image}
            alt={post.data.title}
          />
        </div>
      )}

      <hr />

      <div class="post-content">
        <Content />
      </div>
    </article>
  </main>
</Layout>

<style>
  main {
    min-height: 100vh;
    padding: 4rem 1.5rem;
    background-color: #f8fafc;
  }

  article {
    max-width: 800px;
    margin: 0 auto;
    padding: 3rem;
    background-color: white;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
  }

  .post-header {
    margin-bottom: 2rem;
  }

  .post-label {
    margin: 0 0 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #64748b;
  }

  h1 {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.1;
    font-weight: 800;
    color: #0f172a;
  }

  .description {
    margin: 0 0 1.25rem;
    font-size: 1.2rem;
    line-height: 1.6;
    color: #64748b;
  }

  .author {
    margin: 0;
    font-size: 0.95rem;
    color: #475569;
  }

  .post-image-wrapper {
    width: 100%;
    margin: 2rem 0;
    overflow: hidden;
    border-radius: 14px;
    background-color: #f1f5f9;
  }

  .post-image {
    display: block;
    width: 100%;
    height: 380px;
    object-fit: cover;
  }

  hr {
    margin: 2rem 0;
    border: 0;
    border-top: 1px solid #e2e8f0;
  }

  .post-content {
    font-size: 1.05rem;
    line-height: 1.8;
    color: #334155;
  }

  .post-content :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-size: 1.75rem;
    line-height: 1.3;
    color: #0f172a;
  }

  .post-content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.35rem;
    color: #0f172a;
  }

  .post-content :global(p) {
    margin: 0 0 1.25rem;
  }

  .post-content :global(a) {
    color: #2563eb;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-content :global(a:hover) {
    color: #1d4ed8;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 1rem 0 1.5rem;
    padding-left: 1.5rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .post-content :global(blockquote) {
    margin: 1.5rem 0;
    padding: 1rem 1.5rem;
    border-left: 4px solid #94a3b8;
    background-color: #f8fafc;
    color: #475569;
    font-style: italic;
  }

  .post-content :global(code) {
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    background-color: #f1f5f9;
    font-size: 0.9em;
  }

  .post-content :global(pre) {
    margin: 1.5rem 0;
    padding: 1.25rem;
    overflow-x: auto;
    border-radius: 10px;
    background-color: #0f172a;
    color: #e2e8f0;
  }

  .post-content :global(pre code) {
    padding: 0;
    background: transparent;
  }

  .post-content :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 2rem auto;
    border-radius: 12px;
  }

  @media (max-width: 640px) {
    main {
      padding: 2rem 1rem;
    }

    article {
      padding: 1.5rem;
      border-radius: 12px;
    }

    .description {
      font-size: 1.05rem;
    }

    .post-content {
      font-size: 1rem;
    }

    .post-image {
      height: 220px;
    }
  }
</style>
