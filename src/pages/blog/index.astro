---
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
---

<main>
  <h1>Blog</h1>

  {
    posts.map((post) => (
      <article>
        <h2>{post.data.title}</h2>

        <p>{post.data.description}</p>

        <p>
          Por {post.data.author}
        </p>

        <a href={`/blog/${post.id}`}>
          Leer artículo
        </a>
      </article>
    ))
  }
</main>
